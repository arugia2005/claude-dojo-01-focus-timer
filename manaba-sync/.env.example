# サーバー
PORT=3000
NODE_ENV=production
SESSION_SECRET=ランダムな長い文字列（openssl rand -hex 32 で生成）

# 暗号化キー（まなばPW保護用・32バイト hex）
ENCRYPTION_KEY=openssl rand -hex 32 で生成した値

# Google OAuth2
GOOGLE_CLIENT_ID=Google Cloud ConsoleのクライアントID
GOOGLE_CLIENT_SECRET=Google Cloudのクライアントシークレット
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:パスワード@db.xxxx.supabase.co:5432/postgres
